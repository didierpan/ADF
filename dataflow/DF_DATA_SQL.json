{
	"name": "DF_DATA_SQL",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_CIBLE",
						"type": "DatasetReference"
					},
					"name": "CONSO"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "LS_SQL_CopyDataTP",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          date_cet as timestamp,",
				"          heure_cet as string,",
				"          date_heure_utc as timestamp,",
				"          intensite_emissions_conso as integer,",
				"          part_enr_conso as integer,",
				"          Source as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> CONSO",
				"CONSO derive(Source = initCap(Source)) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(Source),",
				"     Count = count(Source)) ~> aggregate1",
				"aggregate1 alterRow(upsertIf(true())) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'AGG_SOURCE',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: true,",
				"     keys:['Source'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}